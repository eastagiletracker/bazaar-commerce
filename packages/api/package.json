{
  "name": "@acme/api",
  "version": "2.3.0",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "exports": {
    "./_generated": {
      "types": "./.mercur/routes.d.ts"
    }
  },
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build && node ./scripts/bundle-dashboards.mjs",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "start": "medusa start",
    "dev": "medusa develop",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "codegen": "mercurjs codegen",
    "cloud:prebuild": "mercurjs codegen",
    "seed:pk": "medusa exec ./src/scripts/seed-pk.ts",
    "seed:commissions": "medusa exec ./src/scripts/seed-commissions.ts",
    "seed:digital": "medusa exec ./src/scripts/seed-digital.ts",
    "test:settlement": "medusa exec ./src/scripts/test-settlement.ts",
    "test:payout": "medusa exec ./src/scripts/test-payout-provider.ts",
    "test:csv": "medusa exec ./src/scripts/test-csv-import.ts",
    "test:shopify": "medusa exec ./src/scripts/test-shopify.ts",
    "reparent:demo": "medusa exec ./src/scripts/reparent-demo-categories.ts",
    "test:otp": "medusa exec ./src/scripts/test-otp.ts",
    "test:confirmation": "medusa exec ./src/scripts/test-confirmation.ts",
    "confirm:link": "medusa exec ./src/scripts/confirmation-link.ts",
    "test:digital": "medusa exec ./src/scripts/test-digital.ts",
    "seed:digital-demo": "medusa exec ./src/scripts/seed-digital-demo.ts",
    "digital:link": "medusa exec ./src/scripts/digital-link.ts"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.18.0",
    "@medusajs/cli": "2.18.0",
    "@medusajs/core-flows": "2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/dashboard": "2.18.0",
    "@medusajs/admin-shared": "2.18.0",
    "@medusajs/medusa": "2.18.0",
    "@medusajs/draft-order": "2.18.0",
    "@mercurjs/core": "2.3.0",
    "@mercurjs/types": "2.3.0",
    "http-proxy-middleware": "3.0.7",
    "@mercurjs/cli": "2.3.0"
  },
  "devDependencies": {
    "@acme/admin": "*",
    "@acme/vendor": "*",
    "@medusajs/test-utils": "2.20.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "jest": "^30.5.1",
    "prop-types": "^15.8.1",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  }
}
