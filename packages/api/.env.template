# Copy to .env before running the API.

# --- Core -------------------------------------------------------------------
DATABASE_URL=postgres://pkmkt:pkmkt@localhost:5434/pkmkt

# REQUIRED. Without a real Redis, Medusa silently substitutes an in-memory lock
# and event bus, and the payout and reconciliation jobs stop surviving a
# restart. medusa-config.ts throws rather than degrade.
REDIS_URL=redis://localhost:6381

# Change both before deploying anywhere real.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# --- CORS -------------------------------------------------------------------
STORE_CORS=http://localhost:3100
ADMIN_CORS=http://localhost:3103,http://localhost:3101
VENDOR_CORS=http://localhost:3102
AUTH_CORS=http://localhost:3100,http://localhost:3102,http://localhost:3103,http://localhost:3101

# --- App URLs ---------------------------------------------------------------
STOREFRONT_URL=http://localhost:3100
MERCUR_VENDOR_URL=http://localhost:3102
ADMIN_DEV_PORT=3103
VENDOR_DEV_PORT=3102
STOREFRONT_REVALIDATE_URL=http://localhost:3100
STOREFRONT_REVALIDATE_SECRET=supersecret

# The local file provider bakes this into every uploaded file URL. It must be
# the publicly reachable origin in production or images resolve to localhost.
FILE_BACKEND_URL=http://localhost:3101/static

# --- Digital code vault -----------------------------------------------------
# Encrypts sellable codes at rest. DELIBERATELY NOT JWT_SECRET: session secrets
# get rotated, shared and pasted into terminals, and the key protecting unsold
# inventory should not carry that blast radius.
#
# Generate with:  openssl rand -base64 32
# Production refuses to start without it. Development falls back to a fixed key
# that is in the source history and must never be used anywhere real.
PK_VAULT_KEY=

# --- Payout rail ------------------------------------------------------------
# No payment service provider is contracted, so this runs a mock driver that
# models pending KYC and failed disbursements rather than pretending every
# payout succeeds.
PK_PSP_DRIVER=mock
PK_PSP_AUTO_ACTIVATE=false

# --- Order confirmation (anti-RTO) ------------------------------------------
# Tunables for the risk scorer and the sweep job. Defaults are conservative;
# retune once real return data exists, because it will not match these.
# PK_CONFIRM_MEDIUM_AT=15
# PK_CONFIRM_HIGH_AT=45
# PK_CONFIRM_HIGH_VALUE=25000
# PK_CONFIRM_TYPICAL_VALUE=3500
# PK_CONFIRM_RETRY_MINUTES=45
# PK_CONFIRM_MAX_ATTEMPTS=2
# PK_CONFIRM_ESCALATION_HOURS=6
# PK_CONFIRM_TOKEN_TTL_HOURS=48

# --- Digital fraud gate -----------------------------------------------------
# PK_DIGITAL_FIRST_CEILING=5000
# PK_DIGITAL_MAX_PER_HOUR=3
# PK_DIGITAL_MAX_PER_DAY=8
# PK_DIGITAL_MAX_VALUE_DAY=30000
# PK_DIGITAL_HOLD_AT=25
# PK_DIGITAL_REFUSE_AT=70

# --- Messaging --------------------------------------------------------------
# No SMS or WhatsApp gateway is contracted; both print to the console.
# Set to "none" to force the SMS fallback path.
# PK_WHATSAPP_DRIVER=console
# PK_WA_TEMPLATE_CONFIRM=order_confirm_v1

# Used when no payment provider identifies itself. Cash on delivery is roughly
# 95% of the market, so it is both the honest guess and the safe one.
# PK_DEFAULT_PAYMENT_METHOD=cod
