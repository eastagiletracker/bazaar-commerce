# Copy to .env before running this panel.
#
# Without it the panel defaults to Medusa's stock port, localhost:9000. The
# dashboard still loads and looks fine — but every API call fails and logging
# in silently does nothing, with no error shown. Easy hour to lose.
#
# Our API runs on 3101 (see packages/api/.env).
VITE_MERCUR_BACKEND_URL=http://localhost:3101
MERCUR_BACKEND_URL=http://localhost:3101
