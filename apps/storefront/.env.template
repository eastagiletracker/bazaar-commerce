# Copy to .env before running the storefront.

MEDUSA_BACKEND_URL=http://localhost:3101

# Create one in the admin (Settings > Publishable API keys), or read the seeded
# one out of the database. Required for every Store API call.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

NEXT_PUBLIC_BASE_URL=http://localhost:3100
NEXT_PUBLIC_DEFAULT_REGION=pk
NEXT_PUBLIC_VENDOR_URL=http://localhost:3102

NEXT_PUBLIC_SITE_NAME="Bazaar"
NEXT_PUBLIC_SITE_DESCRIPTION="Buy from thousands of sellers across Pakistan. Cash on delivery."

# Must match STOREFRONT_REVALIDATE_SECRET in packages/api/.env.
REVALIDATE_SECRET=supersecret
